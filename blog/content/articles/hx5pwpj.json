    {
      "type": "heading",
      "text": "· Rodeo & Le City ·",
      "url": null,
      "full_url": null,
      "alt": null,
      "columns": 2,
      "items": []
    },
    {
      "type": "paragraph",
      "text": "The new Rodeo Tote streamlines the original flap construction, with a naturally draped front panel that conveys a free-spirited attitude, while the open top makes it easy to reach in and out. This season it arrives in aged vegetable-tanned leather, cobalt blue, red and green suede, and ivory-beige calfskin, among other materials.",
      "url": null,
      "full_url": null,
      "alt": null,
      "columns": 2,
      "items": []
