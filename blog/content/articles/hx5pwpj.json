    {
      "type": "heading",
      "text": "· Other New Shapes ·",
      "url": null,
      "full_url": null,
      "alt": null,
      "columns": 2,
      "items": []
    },
    {
      "type": "paragraph",
      "text": "The bucket bag is constructed from triangular leather panels and metal studs, evoking a warrior's armor. Its openwork design is light and airy, bringing a breathable quality to summer dressing.",
      "url": null,
      "full_url": null,
      "alt": null,
      "columns": 2,
      "items": []
    },
    {
      "type": "image",
      "text": null,
      "url": "https://cdn.kynbag.com/images/hx5pwpj/445cd357b698db8e.jpg",
