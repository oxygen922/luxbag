    {
      "type": "paragraph",
      "text": "The new scarves come in a 90x90cm size, crafted from 100% mulberry silk with a light, silky, and fluid drape, finished with hand-rolled edges and made entirely in Italy. Each scarf is priced at ¥4,900.",
      "url": null,
      "full_url": null,
      "alt": null,
      "columns": 2,
      "items": []
    },
