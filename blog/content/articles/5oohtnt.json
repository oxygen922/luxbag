      "columns": 2,
      "items": []
    },
    {
      "type": "paragraph",
      "text": "The PRADA Galleria bag family welcomed a new member in 2025. This new iteration adjusts the classic \"killer bag\" proportions to a horizontal East-West silhouette, with handles extended for shoulder carry. Exotic animal prints evoke the maximalist Y2K era.",
      "url": null,
      "full_url": null,
      "alt": null,
      "columns": 2,
      "items": []
