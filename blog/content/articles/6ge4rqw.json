  ],
  "blocks": [
    {
      "type": "paragraph",
      "text": "Louis Vuitton's iconic handbag lineup returns refreshed for the Fall/Winter 2026 collection, with the Alma and the OnTheGo reimagined in softer structures that lend their classic silhouettes an easy, relaxed attitude. The Pochette Métis now comes with a detachable short strap, opening up even more ways to carry it.",
      "url": null,
      "full_url": null,
      "alt": null,
      "columns": 2,
      "items": []
