    {
      "type": "heading",
      "text": "· Pochette Métis ·",
      "url": null,
      "full_url": null,
      "alt": null,
      "columns": 2,
      "items": []
    },
    {
      "type": "paragraph",
      "text": "The new Pochette Métis Small keeps its envelope-style flap and S-Lock closure; this season's highlight is soft leather binding along the sides, which makes the bag feel lighter overall. A detachable shoulder strap is also new, allowing it to be carried by hand, on the shoulder or crossbody for plenty of styling options. It comes in two trims: black and caramel.",
      "url": null,
      "full_url": null,
      "alt": null,
      "columns": 2,
      "items": []
