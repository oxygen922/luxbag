    {
      "type": "paragraph",
      "text": "The Bolero bowling bag was unveiled at Balenciaga's Summer 26 runway show, designed by new Creative Director Pierpaolo Piccioli. Its form draws from the Bolero short jacket created by the house's founder, Cristóbal Balenciaga, in 1937.",
      "url": null,
      "full_url": null,
      "alt": null,
      "columns": 2,
      "items": []
    },
    {
      "type": "paragraph",
      "text": "Pierpaolo Piccioli, fashion designer, born 1967, nationality Italian, graduate of Sapienza University of Rome, formerly Creative Director at Valentino (2007–2024), Creative Director at Balenciaga (2025–present).",
      "url": null,
      "full_url": null,
      "alt": null,
      "columns": 2,
      "items": []
    },
    {
      "type": "caption",
      "text": "Balenciaga Summer 26 runway show (swipe left or right for more images)",
      "url": null,
      "full_url": null,
      "alt": null,
      "columns": 2,
      "items": []
    },
    {
      "type": "grid",
      "text": null,
