      "columns": 2,
      "items": []
    },
    {
      "type": "paragraph",
      "text": "This Alma Trunk bag features a sculptural body crafted from ivory white calfskin, entirely adorned with a Millefleurs floral motif. Inspired by medieval tapestry patterns, the design also cleverly echoes the house's iconic Monogram flower elements.",
      "url": null,
      "full_url": null,
      "alt": null,
      "columns": 2,
      "items": []
    },
    {
      "type": "image",
      "text": null,
      "url": "https://cdn.kynbag.com/images/w4rdu64/3ff63149f169c9a7.jpg",
      "full_url": "https://cdn.kynbag.com/images/w4rdu64/ccc7c89177fec728.jpg",
      "alt": null,
      "columns": 2,
      "items": []
    },
    {
      "type": "grid",
      "text": null,
      "url": null,
      "full_url": null,
