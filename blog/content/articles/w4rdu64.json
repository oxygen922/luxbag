    {
      "type": "heading",
      "text": "· The Alma Bag ·",
      "url": null,
      "full_url": null,
      "alt": null,
      "columns": 2,
      "items": []
    },
    {
      "type": "paragraph",
      "text": "The Alma bag was born in 1992, but its design lineage dates back to the Squire bag introduced in 1934. Its distinctly architectural lines are rooted in the Art Deco style that flourished in the 1930s, and also echo the arch of the Pont de l'Alma bridge over the Seine in Paris—evoking the grandeur of the 8th arrondissement and the poetic flow of the river.",
      "url": null,
      "full_url": null,
      "alt": null,
      "columns": 2,
      "items": []
    },
    {
      "type": "image",
      "text": null,
      "url": "https://cdn.kynbag.com/images/w4rdu64/23f685600ee967c3.jpg",
      "full_url": "https://cdn.kynbag.com/images/w4rdu64/b39d4c5269788bd7.jpg",
      "alt": null,
      "columns": 2,
      "items": []
    },
    {
      "type": "grid",
      "text": null,
      "url": null,
