    {
      "type": "paragraph",
      "text": "The bag measures 19x11x22 cm and is lined in soft, delicate lambskin. It features a flat pocket on the back and a hot-stamped leather label. A metal padlock enhances security.",
      "url": null,
      "full_url": null,
      "alt": null,
