    {
      "type": "paragraph",
      "text": "The Alma Trunk is the latest addition to the house's Trunk hard-case family, seamlessly blending a modern silhouette with heritage trunk-making techniques. The metal corner guards at the base not only reinforce and protect the bag but also add a classical touch that perfectly aligns with the season's medieval theme.",
      "url": null,
      "full_url": null,
      "alt": null,
      "columns": 2,
      "items": []
    },
