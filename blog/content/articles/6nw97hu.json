      "items": []
    },
    {
      "type": "paragraph",
      "text": "The Clou de Forge jewelry chain is the most eye-catching decorative element on this bag, drawing on the signature horseshoe nail motif from the brand's Clou de Forge jewelry collection and continuing its equestrian-inspired imagination.",
      "url": null,
      "full_url": null,
      "alt": null,
      "columns": 2,
      "items": []
    },
