    },
    {
      "type": "paragraph",
      "text": "Open the bag to reveal a sweet pink satin lining with a gold logo nameplate.",
      "url": null,
      "full_url": null,
      "alt": null,
      "columns": 2,
      "items": []
    },
    {
      "type": "grid",
