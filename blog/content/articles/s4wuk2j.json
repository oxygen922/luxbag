    {
      "type": "heading",
      "text": "· Trio East West Bag ·",
      "url": null,
      "full_url": null,
      "alt": null,
      "columns": 2,
      "items": []
    },
    {
      "type": "paragraph",
      "text": "The Trio revisits the three-in-one design from the Old Céline era, and the winter collection introduces a new \"east-west\" horizontal silhouette. Crafted from supple lambskin in a three-tier accordion structure, it fastens with a clean, convenient Triomphe stud closure, while a central zip pocket adds extra security. Chili red paired with iris purple creates a bold, passionate, and unmistakably elevated visual combination.",
      "url": null,
      "full_url": null,
      "alt": null,
      "columns": 2,
      "items": []
    },
