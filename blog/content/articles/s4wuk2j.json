    {
      "type": "heading",
      "text": "· Flair Bag ·",
      "url": null,
      "full_url": null,
      "alt": null,
      "columns": 2,
      "items": []
    },
    {
      "type": "paragraph",
      "text": "CELINE's Winter 2026 collection introduces the all-new Flair bag, defined by a structured metal frame at the opening that tapers down into a rounded, upright body, creating a fluid draped effect reminiscent of a vintage doctor's bag. It features a sculptural single handle and a classic envelope-style closure, with a single Triomphe metal turn-lock at the center as a striking focal point.",
      "url": null,
      "full_url": null,
      "alt": null,
      "columns": 2,
      "items": []
