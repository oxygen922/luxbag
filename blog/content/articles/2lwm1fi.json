      "alt": null,
      "columns": 2,
      "items": []
    },
    {
      "type": "paragraph",
      "text": "Subtle creases lend a vintage, nostalgic filter to the bag, echoing the leather corner guards on the sides for an elegant, timeless look.",
      "url": null,
      "full_url": null,
      "alt": null,
      "columns": 2,
      "items": []
    },
