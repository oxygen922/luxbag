    {
      "type": "paragraph",
      "text": "The bag is rendered in a vibrant red, paired with a matching enamel triangular metal logo. The glossy finish contrasts beautifully with the gold-tone hardware. This bright, compact bag adds a highlight to any outfit, and red is also considered auspicious in many cultures, making it a lucky piece.",
      "url": null,
      "full_url": null,
      "alt": null,
      "columns": 2,
      "items": []
    },
    {
      "type": "image",
      "text": null,
