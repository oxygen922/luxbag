      "type": "heading",
      "text": "· Soft Lux Waxed Leather ·",
      "url": null,
      "full_url": null,
      "alt": null,
      "columns": 2,
      "items": []
    },
    {
      "type": "paragraph",
      "text": "The bag is made from Soft Lux waxed leather, which has a unique liquid-glass sheen. The deep polishing process gives the calfskin a silky, smooth feel and rich color depth.",
      "url": null,
      "full_url": null,
      "alt": null,
      "columns": 2,
      "items": []
    },
    {
      "type": "image",
      "text": null,
