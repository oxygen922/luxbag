    {
      "type": "paragraph",
      "text": "A slim leather strap wraps around the zipper, flowing smoothly through the handles. The small metal buckle draws from Prada's signature belt hardware, while the side drawcord can cinch the silhouette and adds a playful touch.",
      "url": null,
      "full_url": null,
      "alt": null,
      "columns": 2,
      "items": []
    },
