    {
      "type": "heading",
      "text": "· What Fits Inside? ·",
      "url": null,
      "full_url": null,
      "alt": null,
      "columns": 2,
      "items": []
    },
    {
      "type": "paragraph",
      "text": "The cubic structure puts the entire interior in plain view, so you can spot what you need at a glance. Each side measures 12.5cm — slightly shorter than an iPhone Pro — so the phone fits only when angled, though the clasp still closes properly.",
      "url": null,
      "full_url": null,
      "alt": null,
      "columns": 2,
      "items": []
    },
    {
      "type": "image",
      "text": null,
