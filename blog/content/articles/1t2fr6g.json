    {
      "type": "heading",
      "text": "· What Can This Bag Hold? ·",
      "url": null,
      "full_url": null,
      "alt": null,
      "columns": 2,
      "items": []
    },
    {
      "type": "paragraph",
      "text": "The Boston silhouette offers a flat base and generous storage. The interior is lined in black fabric, with a double-zip closure for easy access, and a metal padlock adds security.",
      "url": null,
      "full_url": null,
      "alt": null,
      "columns": 2,
      "items": []
    },
