    {
      "type": "paragraph",
      "text": "LV Speedy Trunk 25 handbag · Designer Nicolas Ghesquière · Dimensions 27cm L x 20cm H x 15cm D · Weight 725g · Retail price ¥25,300",
      "url": null,
