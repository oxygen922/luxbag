      "alt": null,
      "columns": 2,
      "items": []
    },
    {
      "type": "paragraph",
      "text": "With the long strap, you can adjust the length via the buckle to suit any frame.",
      "url": null,
      "full_url": null,
      "alt": null,
      "columns": 2,
      "items": []
