      "alt": null,
      "columns": 2,
      "items": []
    },
    {
      "type": "heading",
      "text": "· Baguette® 26424 ·",
      "url": null,
      "full_url": null,
      "alt": null,
      "columns": 2,
      "items": []
    },
    {
      "type": "paragraph",
      "text": "The Baguette® 26424 made its debut in the Fall/Winter 2026 collection—the first show by FENDI's Chief Creative Officer, Maria Grazia Chiuri. It stays true to the original 1997 Baguette silhouette and model code 26424, signaling a return to the house's roots.",
      "url": null,
      "full_url": null,
      "alt": null,
      "columns": 2,
      "items": []
    },
    {
      "type": "caption",
      "text": "FENDI Fall/Winter 2026 fashion show (swipe left/right for more images)",
      "url": null,
      "full_url": null,
      "alt": null,
      "columns": 2,
      "items": []
    },
    {
      "type": "image",
      "text": null,
      "url": "https://cdn.kynbag.com/images/w2mm6yo/cf4557a01beeac42.jpg",
      "full_url": "https://cdn.kynbag.com/images/w2mm6yo/cf4557a01beeac42.jpg",
