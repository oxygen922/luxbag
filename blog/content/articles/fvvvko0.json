    {
      "type": "paragraph",
      "text": "The silk scarf is a CELINE signature piece—it carries the brand's history while seamlessly integrating into modern life in endless ways.",
      "url": null,
      "full_url": null,
      "alt": null,
      "columns": 2,
      "items": []
