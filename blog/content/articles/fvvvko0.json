    {
      "type": "paragraph",
      "text": "The Teen size is an intermediate between the small and medium in the Triomphe line, measuring 18.5x13.5x7 cm. It's especially ideal for those seeking a practical everyday bag with a more compact frame.",
      "url": null,
      "full_url": null,
      "alt": null,
      "columns": 2,
      "items": []
    },
    {
      "type": "image",
      "text": null,
      "url": "https://cdn.kynbag.com/images/fvvvko0/80acc9c2e11b2f27.jpg",
