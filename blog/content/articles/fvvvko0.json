    {
      "type": "paragraph",
      "text": "Designed by the brand's new creative director Michael Rider, this bag features an Art Deco-inspired geometric scarf print as its primary visual language. It nods to the house's early classic designs while infusing a relaxed, contemporary attitude, presenting a more inclusive brand image.",
      "url": null,
      "full_url": null,
      "alt": null,
      "columns": 2,
      "items": []
