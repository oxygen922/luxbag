    {
      "type": "paragraph",
      "text": "The chunky silver metal ball pendant serves as the bag's style statement, adding a playful accent to the minimalist design. The ball is engraved with the PRADA MILANO logo, subtly asserting the brand's identity.",
      "url": null,
      "full_url": null,
      "alt": null,
      "columns": 2,
      "items": []
    },
    {
      "type": "image",
      "text": null,
