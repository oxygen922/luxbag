          "price": ""
        }
      ]
    },
    {
      "type": "paragraph",
      "text": "Inside the main compartment, there's a flat zip pocket for tickets, documents, and other valuables, with a metal logo plaque set below.",
      "url": null,
      "full_url": null,
      "alt": null,
      "columns": 2,
      "items": []
    },
