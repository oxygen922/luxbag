    {
      "type": "paragraph",
      "text": "This handbag measures '12.5x21x9cm' in mini size, yet it holds more than you'd expect. It features a main compartment, plus zip closures on both sides to keep your belongings secure, no matter how you move.",
      "url": null,
      "full_url": null,
      "alt": null,
      "columns": 2,
      "items": []
    },
    {
      "type": "grid",
      "text": null,
