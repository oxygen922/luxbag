    {
      "type": "paragraph",
      "text": "First unveiled during the Fall/Winter 2016 men's runway show, Monogram Eclipse coated canvas draws inspiration from obsidian. Its charcoal-gray base is punctuated with light gray Monogram motifs, offering a cooler, more masculine alternative to the classic canvas.",
      "url": null,
      "full_url": null,
      "alt": null,
      "columns": 2,
      "items": []
