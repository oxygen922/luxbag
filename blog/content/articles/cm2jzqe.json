    {
      "type": "paragraph",
      "text": "For Fall/Winter 2025, Miu Miu takes 'Cognac' as its key note—a color borrowed from French brandy, evoking maturity and naturalness. The aged calfskin reveals subtle, mottled color variations and a glossy patina, like marks left by time.",
      "url": null,
      "full_url": null,
      "alt": null,
      "columns": 2,
      "items": []
    },
    {
      "type": "image",
      "text": null,
      "url": "https://cdn.kynbag.com/images/cm2jzqe/9f34ffc8d8be714b.jpg",
      "full_url": "https://cdn.kynbag.com/images/cm2jzqe/9f34ffc8d8be714b.jpg",
      "alt": null,
      "columns": 2,
      "items": []
    },
