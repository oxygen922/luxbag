    {
      "type": "heading",
      "text": "· Pride and Prejudice ·",
      "url": null,
      "full_url": null,
      "alt": null,
      "columns": 2,
      "items": []
    },
    {
      "type": "paragraph",
      "text": "The collector's edition cover of English author Jane Austen's novel *Pride and Prejudice* also inspires the new-season Book Tote. An elegant and vibrant peacock green backdrop sets off freely growing rose vines, with romantic floral elements echoing the novel's themes of love.",
      "url": null,
      "full_url": null,
      "alt": null,
      "columns": 2,
      "items": []
