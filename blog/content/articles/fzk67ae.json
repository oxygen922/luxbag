    {
      "type": "image",
      "text": null,
      "url": "https://cdn.kynbag.com/images/fzk67ae/c8aed3c553bba545.jpg",
      "full_url": "https://cdn.kynbag.com/images/fzk67ae/0b8d53b1aaf93653.jpg",
