    {
      "type": "paragraph",
      "text": "A multitude of gold tones shimmer across a diverse range of materials — lame, organza, embossed lace, tulle, brocade, jacquard, metallic-finish cotton and gold-leafed latex — each revealing fresh allure in every look.",
      "url": null,
      "full_url": null,
      "alt": null,
      "columns": 2,
      "items": []
    },
