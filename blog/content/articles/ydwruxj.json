    {
      "type": "paragraph",
      "text": "Accessories are likewise punctuated with gold, expressing maximalist luxury through minimalist design: statement gemstone filigree earrings, or gilded metal chain-structured footwear set on sinuous serpentine heels, delivering a thrill both seductive and dangerous — the very essence of Saint Laurent.",
      "url": null,
      "full_url": null,
      "alt": null,
      "columns": 2,
      "items": []
    },
