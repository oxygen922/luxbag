    {
      "type": "paragraph",
      "text": "Specs at a glance · Type 964 coupé chassis · Saffron carbon-fiber body with speed-activated rear wing · 4.0L naturally aspirated air-cooled flat-six engine · Six-speed manual gearbox · Rear-wheel drive · Carbon-ceramic braking system",
      "url": null,
      "full_url": null,
      "alt": null,
      "columns": 2,
      "items": []
    },
    {
      "type": "heading",
      "text": "· Porsche 911 Classic Turbo Cabriolet ·",
      "url": null,
      "full_url": null,
      "alt": null,
      "columns": 2,
      "items": []
