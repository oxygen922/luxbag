    {
      "type": "paragraph",
      "text": "The assorted pockets keep everything organized, balancing good looks with real utility and lending the bag a cool, workwear-inspired edge. The two large flap pockets, front and back, conceal magnetic closures that keep contents secure.",
      "url": null,
      "full_url": null,
      "alt": null,
      "columns": 2,
      "items": []
    },
