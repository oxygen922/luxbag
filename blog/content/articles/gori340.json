    {
      "type": "paragraph",
      "text": "You can swap between the two straps, remove them to use the bag as a sleek clutch, or keep both attached for multiple carrying options in different situations.",
      "url": null,
      "full_url": null,
      "alt": null,
      "columns": 2,
      "items": []
    },
