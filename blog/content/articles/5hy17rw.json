    {
      "type": "paragraph",
      "text": "Above the curved pocket, the designer has stamped the brand's logo letters in gold, making it the most iconic and easily recognizable symbol.",
      "url": null,
      "full_url": null,
      "alt": null,
      "columns": 2,
      "items": []
    },
