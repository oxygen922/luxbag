    {
      "type": "heading",
      "text": "· My Peekaboo ·",
      "url": null,
      "full_url": null,
      "alt": null,
      "columns": 2,
      "items": []
    },
    {
      "type": "paragraph",
      "text": "The new My Peekaboo stays true to the iconic silhouette of the original 2009 Peekaboo, with its distinctive front-opening design that plays on the contrast between exposed and concealed beauty. The standout update is the adjustable long strap, making it easier to wear over the shoulder. Crafted in solid-color leather, it strips away ostentation to focus on the raw narrative of the material.",
      "url": null,
      "full_url": null,
      "alt": null,
      "columns": 2,
      "items": []
    },
