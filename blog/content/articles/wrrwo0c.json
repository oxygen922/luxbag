    {
      "type": "heading",
      "text": "· Sac De Jour ·",
      "url": null,
      "full_url": null,
      "alt": null,
      "columns": 2,
      "items": []
    },
    {
      "type": "paragraph",
      "text": "The Sac De Jour tote is pieced together from two leathers with distinct textures—Togo and Swift calfskin—with exposed stitching tracing clean lines. The strap running across the top of the body takes its cue from a stirrup leather, continuing the classic equestrian heritage. Inside, the bag is generously roomy and lined in H canvas, while wide accordion gussets give the body a structured, hard-wearing shape that stays firm and poised whether open or closed.",
      "url": null,
      "full_url": null,
      "alt": null,
      "columns": 2,
      "items": []
    },
