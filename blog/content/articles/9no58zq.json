    {
      "type": "heading",
      "text": "· Fringe and Weave ·",
      "url": null,
      "full_url": null,
      "alt": null,
      "columns": 2,
      "items": []
    },
    {
      "type": "paragraph",
      "text": "The Intrecciato weaving technique still runs through the entire collection. Bags are crafted from raffia, fabric, ultra-fine leather strips, and other materials, accented with extra-long fringe, fluffy raw edges, and tassel-like pendants. The \"oversized\" proportions carry dramatic tension, evoking a nomad wandering the city.",
      "url": null,
      "full_url": null,
      "alt": null,
      "columns": 2,
      "items": []
    },
