    {
      "type": "paragraph",
      "text": "The Dust bag drawstring pouch is covered in burgundy butterfly-shaped leather appliqués, giving it a romantic, poetic feel; the shopping bag is patchworked from crochet lace motifs, its pure white hue clean and ethereal.",
      "url": null,
      "full_url": null,
      "alt": null,
      "columns": 2,
      "items": []
    },
